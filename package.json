{
  "name": "echopath",
  "private": true,
  "version": "0.1.0",
  "description": "EchoPath: real-time, on-device audio navigation aid for the visually impaired",
  "type": "module",
  "scripts": {
    "setup:assets": "node scripts/fetch-assets.mjs",
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite --host",
    "dev:https": "node scripts/fetch-assets.mjs && vite --host --mode https",
    "prebuild": "node scripts/fetch-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "5.8",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "onnxruntime-web": "^1.22.0"
  }
}
